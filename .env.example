# Coletor
USER_AGENT=Mozilla/5.0
TIMEOUT=20
DELAY_MIN=1
DELAY_MAX=3

# Mercado Livre OAuth
# NÃO coloque valores reais neste arquivo se ele for versionado.
ML_CLIENT_ID=
ML_CLIENT_SECRET=SEU_ML_CLIENT_SECRET
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=SEU_ML_ACCESS_TOKEN
ML_REFRESH_TOKEN=SEU_ML_REFRESH_TOKEN

# Opcional. Só ative se marcar PKCE nas configurações da aplicação do Mercado Livre.
ML_USE_PKCE=false

# Shopee - reservado para a próxima integração Python
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Ritmo de coleta (padrões conservadores)
REQUEST_MIN_DELAY_SECONDS=1.25
REQUEST_JITTER_SECONDS=0.45
ML_MIN_DELAY_SECONDS=1.0
ML_JITTER_SECONDS=0.35
BROWSER_MIN_DELAY_SECONDS=1.8
BROWSER_JITTER_SECONDS=0.6
HTTP_MAX_RETRIES=2
HTTP_CACHE_DIR=.cache/produto_ia_http
# Por padrão false: evita testar /sale_price e /prices se /items já estiver bloqueado.
ML_TRY_RESTRICTED_PRICE_ENDPOINTS=false

# CriaByte API — v14 (consulta/planejamento; nunca versione credenciais reais)
CRIABYTE_API_URL=https://api.criabyte.com.br
CRIABYTE_API_TIMEOUT=20
CRIABYTE_SESSION_COOKIE_NAME=pcbuilder_session
# Opção A: sessão já autenticada do ADMIN/EDITOR/REVISOR para consultas administrativas.
CRIABYTE_SESSION_TOKEN=
# Opção B: login administrativo; use apenas no .env local e nunca no ZIP/repositório.
CRIABYTE_ADMIN_EMAIL=
CRIABYTE_ADMIN_PASSWORD=

# Enriquecimento técnico externo (opcional)
ENRICHMENT_AUTO=false
ENRICHMENT_TIMEOUT=15
ENRICHMENT_SEARCH_MIN_DELAY_SECONDS=2.0
ENRICHMENT_SEARCH_JITTER_SECONDS=0.8
ENRICHMENT_SOURCE_MIN_DELAY_SECONDS=2.0
ENRICHMENT_SOURCE_JITTER_SECONDS=0.8

# Surfsky v14.9 - fallback cloud Magalu (somente no ambiente, nunca versionar token real)
SURFSKY_TOKEN=SEU_TOKEN_SURFSKY
SURFSKY_API_URL=https://api-de2.surfsky.io
SURFSKY_PROXY_COUNTRY=br
# SURFSKY_PROXY_TIER=shared
# SURFSKY_PROXY_URL=
# SURFSKY_INACTIVE_KILL_TIMEOUT=90
# SURFSKY_FINGERPRINT_OS=win

# v14.16 - descoberta de Hardwares (opcional)
PRODUTO_IA_DISCOVERY_CONCURRENCY=1
DISCOVERY_TOTAL_TIMEOUT_SECONDS=90
DISCOVERY_SOURCE_TIMEOUT_SECONDS=8
DISCOVERY_ENRICHMENT_TIMEOUT_SECONDS=10
DISCOVERY_ENRICHMENT_MAX_SOURCES=4
DISCOVERY_DETAIL_WORKERS=6
DISCOVERY_BULK_BROWSER_FALLBACK=false
