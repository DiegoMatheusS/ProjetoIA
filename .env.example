# Coletor
USER_AGENT=Mozilla/5.0
TIMEOUT=20
DELAY_MIN=1
DELAY_MAX=3

# Mercado Livre OAuth
# NÃO coloque valores reais neste arquivo se ele for versionado.
ML_CLIENT_ID=
ML_CLIENT_SECRET=SEU_ML_CLIENT_SECRET
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=SEU_ML_ACCESS_TOKEN
ML_REFRESH_TOKEN=SEU_ML_REFRESH_TOKEN

# Opcional. Só ative se marcar PKCE nas configurações da aplicação do Mercado Livre.
ML_USE_PKCE=false

# Shopee - reservado para a próxima integração Python
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Ritmo de coleta (padrões conservadores)
REQUEST_MIN_DELAY_SECONDS=1.25
REQUEST_JITTER_SECONDS=0.45
ML_MIN_DELAY_SECONDS=1.0
ML_JITTER_SECONDS=0.35
BROWSER_MIN_DELAY_SECONDS=1.8
BROWSER_JITTER_SECONDS=0.6
HTTP_MAX_RETRIES=2
HTTP_CACHE_DIR=.cache/produto_ia_http
# Por padrão false: evita testar /sale_price e /prices se /items já estiver bloqueado.
ML_TRY_RESTRICTED_PRICE_ENDPOINTS=false

# CriaByte API — v14 (consulta/planejamento; nunca versione credenciais reais)
CRIABYTE_API_URL=https://api.criabyte.com.br
CRIABYTE_API_TIMEOUT=20
CRIABYTE_SESSION_COOKIE_NAME=pcbuilder_session
# Opção A: sessão já autenticada do ADMIN/EDITOR/REVISOR para consultas administrativas.
CRIABYTE_SESSION_TOKEN=
# Opção B: login administrativo; use apenas no .env local e nunca no ZIP/repositório.
CRIABYTE_ADMIN_EMAIL=
CRIABYTE_ADMIN_PASSWORD=

# Enriquecimento técnico externo (opcional)
ENRICHMENT_AUTO=false
ENRICHMENT_TIMEOUT=15
ENRICHMENT_SEARCH_MIN_DELAY_SECONDS=2.0
ENRICHMENT_SEARCH_JITTER_SECONDS=0.8
ENRICHMENT_SOURCE_MIN_DELAY_SECONDS=2.0
ENRICHMENT_SOURCE_JITTER_SECONDS=0.8

# Surfsky v14.9 - fallback cloud Magalu (somente no ambiente, nunca versionar token real)
SURFSKY_TOKEN=SEU_TOKEN_SURFSKY
SURFSKY_API_URL=https://api-de2.surfsky.io
SURFSKY_PROXY_COUNTRY=br
# SURFSKY_PROXY_TIER=shared
# SURFSKY_PROXY_URL=
# SURFSKY_INACTIVE_KILL_TIMEOUT=90
# SURFSKY_FINGERPRINT_OS=win

# v14.16 - descoberta de Hardwares (opcional)
PRODUTO_IA_DISCOVERY_CONCURRENCY=1
DISCOVERY_TOTAL_TIMEOUT_SECONDS=45
DISCOVERY_SOURCE_TIMEOUT_SECONDS=5
DISCOVERY_ENRICHMENT_TIMEOUT_SECONDS=6
DISCOVERY_ENRICHMENT_MAX_SOURCES=2
DISCOVERY_DETAIL_WORKERS=8
DISCOVERY_DETAIL_SOURCE_TIMEOUT_SECONDS=4
DISCOVERY_BULK_TARGET_COVERAGE=0.82
DISCOVERY_BULK_BROWSER_FALLBACK=false

# IA técnica externa complementar (OpenAI)
# A Produto IA tenta primeiro suas próprias fontes técnicas e só depois chama a OpenAI.
IA_TECNICA_PROVIDER=OPENAI
OPENAI_ENABLED=true
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH=true
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=4096

# Agente de pesquisa técnica do Completar com IA
# Todos possuem defaults no código; mantenha ou ajuste somente se precisar.
TECH_RESEARCH_AGENT_ENABLED=true
TECH_RESEARCH_MAX_SOURCES=5
TECH_RESEARCH_TOTAL_TIMEOUT_SECONDS=34
TECH_RESEARCH_SOURCE_TIMEOUT_SECONDS=6
TECH_RESEARCH_TARGET_COVERAGE=0.90
TECH_RESEARCH_CACHE_ENABLED=true
TECH_RESEARCH_CACHE_TTL_SECONDS=86400
# Cache V9: só reaproveita campo com confiança/proveniência suficientes.
TECH_RESEARCH_CACHE_MIN_CONFIDENCE=0.80
TECH_RESEARCH_CACHE_REQUIRE_PROVENANCE=true
TECH_RESEARCH_FOCUSED_QUERY_COUNT=1
TECH_RESEARCH_OPENAI_ROUNDS=2
# V10: se a primeira resposta nao preencher nenhum campo, usa a segunda rodada para exigir o formato Campo: valor.
TECH_RESEARCH_OPENAI_REPAIR_ON_NO_ADVANCE=true
# V11: as rodadas da OpenAI compartilham um teto total e um teto por chamada para evitar requisições longas/499.
TECH_RESEARCH_OPENAI_TOTAL_BUDGET_SECONDS=50
TECH_RESEARCH_OPENAI_MAX_ROUND_SECONDS=28
# V12: URL de Web Search só ganha confiança documental quando a evidência daquele campo foi confirmada.
TECH_RESEARCH_REQUIRE_FIELD_EVIDENCE_FOR_WEB_CONFIDENCE=true
# Campos essenciais preenchidos automaticamente abaixo deste score exigem revisão.
TECH_RESEARCH_MIN_ESSENTIAL_CONFIDENCE=0.80
# Segunda fonte independente para campos essenciais duvidosos. Desligado localmente por padrão.
TECH_RESEARCH_VERIFY_LOW_CONFIDENCE=false
TECH_RESEARCH_VERIFY_MAX_FIELDS=3
TECH_RESEARCH_VERIFY_MAX_SOURCES=2
TECH_RESEARCH_VERIFY_TOTAL_TIMEOUT_SECONDS=8
TECH_RESEARCH_VERIFY_SOURCE_TIMEOUT_SECONDS=3
# Resolve conflitos entre fontes da mesma pesquisa sem tocar em valores originais.
TECH_RESEARCH_RESOLVE_LIVE_CONFLICTS=true
TECH_RESEARCH_CONSENSUS_MIN_SOURCES=2
TECH_RESEARCH_CONSENSUS_MIN_DELTA=0.08

# Enriquecimento técnico automático nas rotas existentes
IA_TECNICA_AUTO=true
IA_TECNICA_AUTO_COVERAGE=0.60
IA_TECNICA_AUTO_MAX_ITEMS=20
IA_TECNICA_AUTO_WORKERS=4
