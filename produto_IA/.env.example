# Coletor
USER_AGENT=Mozilla/5.0
TIMEOUT=20
DELAY_MIN=1
DELAY_MAX=3

# Mercado Livre OAuth
# NÃO coloque valores reais neste arquivo se ele for versionado.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=
ML_ACCESS_TOKEN=
ML_REFRESH_TOKEN=

# Opcional. Só ative se marcar PKCE nas configurações da aplicação do Mercado Livre.
ML_USE_PKCE=false

# Shopee - reservado para a próxima integração Python
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=

# Ritmo de coleta (padrões conservadores)
REQUEST_MIN_DELAY_SECONDS=1.25
REQUEST_JITTER_SECONDS=0.45
ML_MIN_DELAY_SECONDS=1.0
ML_JITTER_SECONDS=0.35
BROWSER_MIN_DELAY_SECONDS=1.8
BROWSER_JITTER_SECONDS=0.6
HTTP_MAX_RETRIES=2
HTTP_CACHE_DIR=.cache/produto_ia_http
# Por padrão false: evita testar /sale_price e /prices se /items já estiver bloqueado.
ML_TRY_RESTRICTED_PRICE_ENDPOINTS=false
