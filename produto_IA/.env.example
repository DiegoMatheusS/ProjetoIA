# Coletor
USER_AGENT=Mozilla/5.0
TIMEOUT=20
DELAY_MIN=1
DELAY_MAX=3

# Mercado Livre OAuth
# NÃO coloque valores reais neste arquivo se ele for versionado.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
