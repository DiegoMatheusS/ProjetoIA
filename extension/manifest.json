{
  "manifest_version": 3,
  "name": "Criabyte - Enviar oferta",
  "version": "0.2.4",
  "description": "Envia a página atual e o link afiliado para o agente do Criabyte.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "clipboardRead",
    "scripting"
  ],
  "host_permissions": [
    "https://*.criabyte.com.br/*",
    "https://*.up.railway.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Criabyte - Enviar oferta",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "124"
}
