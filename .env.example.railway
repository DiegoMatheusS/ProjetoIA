HEADLESS=true
PRODUTO_IA_CONCURRENCY=1
PRODUTO_IA_API_KEY=SUA_CHAVE_PRODUTO_IA
PRODUTO_IA_DOCS=false
ENRICHMENT_AUTO=false
ENRICHMENT_DISABLE=false
CRIABYTE_API_URL=https://api.criabyte.com.br/api

# v14.13 Surfsky - fallback cloud do Magalu/ML e páginas técnicas
SURFSKY_TOKEN=SEU_TOKEN_SURFSKY
SURFSKY_API_URL=https://api-de2.surfsky.io
SURFSKY_PROXY_COUNTRY=br
# SURFSKY_PROXY_TIER=shared
# SURFSKY_PROXY_URL=
# SURFSKY_INACTIVE_KILL_TIMEOUT=90
# SURFSKY_FINGERPRINT_OS=win

# Browserless legado (opcional; nao necessario quando Surfsky esta configurado)
# BROWSERLESS_TOKEN=

# v14.17 - descoberta de Hardwares
PRODUTO_IA_DISCOVERY_CONCURRENCY=1
DISCOVERY_TOTAL_TIMEOUT_SECONDS=45
DISCOVERY_SOURCE_TIMEOUT_SECONDS=5
DISCOVERY_SOURCE_MIN_DELAY_SECONDS=0.6
DISCOVERY_SOURCE_JITTER_SECONDS=0.2
DISCOVERY_ENRICHMENT_TIMEOUT_SECONDS=6
DISCOVERY_ENRICHMENT_MAX_SOURCES=2
DISCOVERY_DETAIL_WORKERS=8
DISCOVERY_DETAIL_SOURCE_TIMEOUT_SECONDS=4
DISCOVERY_BULK_TARGET_COVERAGE=0.82
DISCOVERY_BULK_BROWSER_FALLBACK=false

# v14.18 - Open Icecat (opcional; API estruturada para enriquecer por GTIN ou marca+MPN)
# Crie uma conta Open Icecat e configure pelo menos ICECAT_USERNAME.
# Tokens ficam somente no Projeto IA/Railway, nunca no frontend.
# ICECAT_USERNAME=
# ICECAT_API_TOKEN=
# ICECAT_CONTENT_TOKEN=
ICECAT_LANG=EN
ICECAT_TIMEOUT_SECONDS=8
# ICECAT_API_URL=https://live.icecat.biz/api/

# IA técnica externa complementar (OpenAI)
# Primeiro usa as fontes próprias; OpenAI entra apenas para as lacunas restantes.
IA_TECNICA_PROVIDER=OPENAI
OPENAI_ENABLED=true
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH=true
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=4096

# Agente de pesquisa técnica do Completar com IA
# Estes são os defaults recomendados; o código funciona mesmo sem declarar todos.
TECH_RESEARCH_AGENT_ENABLED=true
TECH_RESEARCH_MAX_SOURCES=5
TECH_RESEARCH_TOTAL_TIMEOUT_SECONDS=34
TECH_RESEARCH_SOURCE_TIMEOUT_SECONDS=6
TECH_RESEARCH_TARGET_COVERAGE=0.90
TECH_RESEARCH_CACHE_ENABLED=true
TECH_RESEARCH_CACHE_TTL_SECONDS=86400
# Reutiliza apenas cache com confiança/proveniência suficientes; valores fracos voltam a ser pesquisados.
TECH_RESEARCH_CACHE_MIN_CONFIDENCE=0.80
TECH_RESEARCH_CACHE_REQUIRE_PROVENANCE=true
TECH_RESEARCH_FOCUSED_QUERY_COUNT=1
TECH_RESEARCH_OPENAI_ROUNDS=2
# Se a primeira resposta vier em formato inutilizavel, a segunda rodada exige Campo: valor.
TECH_RESEARCH_OPENAI_REPAIR_ON_NO_ADVANCE=true
# As duas rodadas compartilham este teto total; cada chamada recebe no máximo o teto por rodada.
TECH_RESEARCH_OPENAI_TOTAL_BUDGET_SECONDS=50
TECH_RESEARCH_OPENAI_MAX_ROUND_SECONDS=28
# Não trate toda URL de Web Search como prova do campo; só eleve confiança quando o campo foi revalidado.
TECH_RESEARCH_REQUIRE_FIELD_EVIDENCE_FOR_WEB_CONFIDENCE=true
# Se a página oficial reextraída discordar da OpenAI, registre conflito e envie o campo para auditoria.
TECH_RESEARCH_RECORD_OFFICIAL_EVIDENCE_CONFLICTS=true
TECH_RESEARCH_MIN_ESSENTIAL_CONFIDENCE=0.80
# Confirma campos essenciais duvidosos em uma segunda fonte, sem browser fallback.
TECH_RESEARCH_VERIFY_LOW_CONFIDENCE=true
TECH_RESEARCH_VERIFY_MAX_FIELDS=3
TECH_RESEARCH_VERIFY_MAX_SOURCES=2
TECH_RESEARCH_VERIFY_TOTAL_TIMEOUT_SECONDS=8
TECH_RESEARCH_VERIFY_SOURCE_TIMEOUT_SECONDS=3
# Resolve conflitos entre fontes já coletadas, sem aumentar o tempo de rede.
TECH_RESEARCH_RESOLVE_LIVE_CONFLICTS=true
TECH_RESEARCH_CONSENSUS_MIN_SOURCES=2
TECH_RESEARCH_CONSENSUS_MIN_DELTA=0.08

# Enriquecimento técnico automático nas rotas existentes
IA_TECNICA_AUTO=true
IA_TECNICA_AUTO_COVERAGE=0.60
IA_TECNICA_AUTO_MAX_ITEMS=20
IA_TECNICA_AUTO_WORKERS=4
